@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 BarutSRB — https://github.com/OmniNull/OmniWM
+
+import CoreGraphics
+
+/// Tracks windows whose app re-constrains them below the notch band
+/// (`-[NSWindow constrainFrameRect:toScreen:]`) when
+/// `gaps.fullHeightWhenMenuBarHidden` asks for the physical top.
+/// Such windows keep the regular top gap below the visible frame instead of
+/// being pushed down and clipped at the bottom.
+struct NotchBandRefusals {
+    private(set) var windowIds: Set<Int> = []
+
+    /// True when a target reaching into the band was observed snapped back to the visible top.
+    static func showsSnapBack(target: CGRect, observed: CGRect, visibleTop: CGFloat) -> Bool {
+        let tolerance: CGFloat = 2
+        guard target.maxY > visibleTop + tolerance else { return false }
+        return abs(observed.maxY - visibleTop) <= tolerance
+            && observed.maxY < target.maxY - tolerance
+    }
+
+    /// Shortens a frame from the top so it ends `topGap` below the visible top; the bottom is kept.
+    static func adjusted(_ frame: CGRect, visibleTop: CGFloat, topGap: CGFloat) -> CGRect {
+        let newTop = visibleTop - topGap
+        guard frame.maxY > visibleTop, newTop > frame.minY else { return frame }
+        return CGRect(x: frame.minX, y: frame.minY, width: frame.width, height: newTop - frame.minY)
+    }
+
+    mutating func record(
+        windowId: Int,
+        target: CGRect,
+        observed: CGRect?,
+        screen: CGRect,
+        visibleFrame: CGRect
+    ) -> CGRect? {
+        guard let observed,
+              Self.showsSnapBack(target: target, observed: observed, visibleTop: visibleFrame.maxY)
+        else { return nil }
+        windowIds.insert(windowId)
+        return Self.adjusted(target, visibleTop: visibleFrame.maxY, topGap: max(0, screen.maxY - target.maxY))
+    }
+
+    func adjustedTarget(windowId: Int, frame: CGRect, screen: CGRect, visibleFrame: CGRect) -> CGRect {
+        guard windowIds.contains(windowId) else { return frame }
+        return Self.adjusted(frame, visibleTop: visibleFrame.maxY, topGap: max(0, screen.maxY - frame.maxY))
+    }
+
+    mutating func forget(windowId: Int) {
+        windowIds.remove(windowId)
+    }
+}
