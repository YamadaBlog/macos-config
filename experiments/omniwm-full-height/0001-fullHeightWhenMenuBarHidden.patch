+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 BarutSRB — https://github.com/OmniNull/OmniWM
+
+import CoreGraphics
+@testable import OmniWM
+import XCTest
+
+final class NotchBandRefusalsTests: XCTestCase {
+    private let screen = CGRect(x: 0, y: 0, width: 1000, height: 800)
+    private let visible = CGRect(x: 0, y: 0, width: 1000, height: 760)
+
+    func testSnappedBackWindowIsRecordedAndShortenedFromTop() {
+        var refusals = NotchBandRefusals()
+        let target = CGRect(x: 8, y: 8, width: 984, height: 784)
+        let observed = CGRect(x: 8, y: -16, width: 984, height: 776)
+        let corrected = refusals.record(
+            windowId: 7,
+            target: target,
+            observed: observed,
+            screen: screen,
+            visibleFrame: visible
+        )
+        XCTAssertEqual(corrected, CGRect(x: 8, y: 8, width: 984, height: 744))
+        XCTAssertEqual(refusals.windowIds, [7])
+        XCTAssertEqual(
+            refusals.adjustedTarget(windowId: 7, frame: target, screen: screen, visibleFrame: visible).maxY,
+            752
+        )
+    }
+
+    func testCooperatingWindowKeepsFullHeight() {
+        var refusals = NotchBandRefusals()
+        let target = CGRect(x: 8, y: 8, width: 984, height: 784)
+        XCTAssertEqual(
+            refusals.record(windowId: 7, target: target, observed: target, screen: screen, visibleFrame: visible),
+            nil
+        )
+        XCTAssertEqual(
+            refusals.adjustedTarget(windowId: 7, frame: target, screen: screen, visibleFrame: visible),
+            target
+        )
+    }
+
+    func testFramesBelowVisibleTopAreNeverTouched() {
+        var refusals = NotchBandRefusals()
+        let target = CGRect(x: 8, y: 8, width: 984, height: 744)
+        XCTAssertEqual(
+            refusals.record(windowId: 7, target: target, observed: target, screen: screen, visibleFrame: visible),
+            nil
+        )
+        refusals.forget(windowId: 7)
+        XCTAssertEqual(NotchBandRefusals.adjusted(target, visibleTop: 760, topGap: 8), target)
+    }
+}
