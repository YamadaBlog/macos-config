From 8ef5f3317274aeedec011d23cd6d3bb412e6081e Mon Sep 17 00:00:00 2001
From: YamadaBlog <118530756+YamadaBlog@users.noreply.github.com>
Date: Fri, 9 Oct 2026 09:51:24 +0200
Subject: [PATCH] Stop services when Accessibility is revoked while running

Revoking the permission left event taps and AX observers installed, which
blocked input system-wide. Release everything on revoke and restart
services on re-grant. Poll AXIsProcessTrusted every second because the
com.apple.accessibility.api notification is not reliably posted on revoke.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Core/Ax/AccessibilityPermissionMonitor.swift      | 11 +++++++++++
 .../Core/Controller/ServiceLifecycleManager.swift     |  9 ++++++++-
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/Sources/OmniWM/Core/Ax/AccessibilityPermissionMonitor.swift b/Sources/OmniWM/Core/Ax/AccessibilityPermissionMonitor.swift
index 804f369a..808f7809 100644
--- a/Sources/OmniWM/Core/Ax/AccessibilityPermissionMonitor.swift
+++ b/Sources/OmniWM/Core/Ax/AccessibilityPermissionMonitor.swift
@@ -9,6 +9,10 @@ final class AccessibilityPermissionMonitor {
     static let shared = AccessibilityPermissionMonitor()
 
     private var task: Task<Void, Never>?
+    private var pollTask: Task<Void, Never>?
+    /// `com.apple.accessibility.api` is not posted reliably when the permission is revoked,
+    /// so the trust state is also polled.
+    static let pollInterval: Duration = .seconds(1)
     private var continuations: [UUID: AsyncStream<Bool>.Continuation] = [:]
     private(set) var isGranted: Bool
 
@@ -23,10 +27,17 @@ final class AccessibilityPermissionMonitor {
                 yield(status)
             }
         }
+        pollTask = Task { [weak self] in
+            while !Task.isCancelled {
+                try? await Task.sleep(for: Self.pollInterval)
+                self?.yield(AXIsProcessTrusted())
+            }
+        }
     }
 
     deinit {
         task?.cancel()
+        pollTask?.cancel()
         let currentContinuations = Array(continuations.values)
         for continuation in currentContinuations {
             continuation.finish()
diff --git a/Sources/OmniWM/Core/Controller/ServiceLifecycleManager.swift b/Sources/OmniWM/Core/Controller/ServiceLifecycleManager.swift
index 68102d99..5c7f0a48 100644
--- a/Sources/OmniWM/Core/Controller/ServiceLifecycleManager.swift
+++ b/Sources/OmniWM/Core/Controller/ServiceLifecycleManager.swift
@@ -66,8 +66,15 @@ final class ServiceLifecycleManager {
                     controller.updateAccessibilityPermissionGranted(true)
                     self.maybeStartServices()
                 } else {
-                    _ = self.controller?.axManager.requestPermission() ?? false
                     controller.updateAccessibilityPermissionGranted(false)
+                    // Revoked while running: event taps and AX observers left installed block
+                    // system-wide input. Release everything now; services restart on re-grant.
+                    if controller.hasStartedServices {
+                        self.stopServices(retainingAXWorkers: false)
+                        self.startPermissionMonitoring()
+                        return
+                    }
+                    _ = self.controller?.axManager.requestPermission() ?? false
                 }
             }
         }
