diff --git a/Sources/OmniWM/Core/Layout/Niri/NiriGestureSnapPlan.swift b/Sources/OmniWM/Core/Layout/Niri/NiriGestureSnapPlan.swift
index 9d8ea26a..b3bf28d5 100644
--- a/Sources/OmniWM/Core/Layout/Niri/NiriGestureSnapPlan.swift
+++ b/Sources/OmniWM/Core/Layout/Niri/NiriGestureSnapPlan.swift
@@ -142,6 +142,26 @@ struct NiriGestureSnapPlan {
         points.append(Point(viewPos: viewPos, columnIndex: columnIndex))
     }
 
+    /// From the point the strip rested on when the gesture began, a projected travel past halfway to the next point,
+    /// capped at `threshold`, goes at least to that next point in the direction of travel (further if the projection
+    /// reaches further); a shorter travel returns to the start. Plain nearest-point snapping made a full-width column
+    /// need twice the gesture of a half-width one, since its neighbouring snap points are twice as far.
+    mutating func intentPoint(startViewPos: Double, projectedViewPos: Double, threshold: Double) -> Point? {
+        guard let start = closestPoint(to: startViewPos) else { return nil }
+        let travel = projectedViewPos - start.viewPos
+        // Points within two gaps of the start show the same view (a column's leading edge vs its neighbour's).
+        let same = 2 * geometry.gaps + 1
+        let ahead = points.filter { travel > 0 ? $0.viewPos > start.viewPos + same : $0.viewPos < start.viewPos - same }
+        guard let next = ahead.min(by: { abs($0.viewPos - start.viewPos) < abs($1.viewPos - start.viewPos) }) else {
+            return closestPoint(to: projectedViewPos)
+        }
+        // Halfway to the next point (nearest-point snapping) but never more than `threshold`: narrow and half-width
+        // columns behave as before, wide and full-width ones no longer need a longer gesture.
+        guard abs(travel) >= min(threshold, abs(next.viewPos - start.viewPos) / 2) else { return start }
+        let reached = ahead.min(by: { abs($0.viewPos - projectedViewPos) < abs($1.viewPos - projectedViewPos) }) ?? next
+        return abs(reached.viewPos - start.viewPos) > abs(next.viewPos - start.viewPos) ? reached : next
+    }
+
     mutating func closestPoint(to projectedViewPos: Double) -> Point? {
         points.sort { $0.viewPos < $1.viewPos }
         return points.min(by: { abs($0.viewPos - projectedViewPos) < abs($1.viewPos - projectedViewPos) })
