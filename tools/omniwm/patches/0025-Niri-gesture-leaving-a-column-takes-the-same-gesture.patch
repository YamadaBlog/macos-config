index 00000000..870666f9
--- /dev/null
+++ b/Tests/OmniWMTests/NiriGestureIntentSnapTests.swift
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 BarutSRB — https://github.com/OmniNull/OmniWM
+
+import CoreGraphics
+@testable import OmniWM
+import XCTest
+
+/// Leaving a column takes the same gesture whatever its width: past halfway to the next snap point, capped at a
+/// quarter of the viewport. Nearest-point snapping needed ~1033 pt from a full-width column, ~516 pt from a half one.
+final class NiriGestureIntentSnapTests: NiriInteractionTestCase {
+    private let viewport: CGFloat = 2058
+    private let gap: CGFloat = 8
+
+    private func landing(widths: [CGFloat], from start: Int = 0, travel: Double, intent: Bool = true) -> Int {
+        let engine = NiriLayoutEngine()
+        let ws = WorkspaceDescriptor.ID()
+        var previous: NiriWindow?
+        for i in widths.indices { previous = addWindow(engine, pid: pid_t(9_300 + i), to: ws, after: previous) }
+        let columns = engine.columns(in: ws)
+        for (column, width) in zip(columns, widths) { column.cachedWidth = width }
+        var state = ViewportState()
+        state.activeColumnIndex = start
+        state.viewOffset = -gap
+        let base = Double(state.viewOffset)
+        state.endGesture(
+            currentOffset: base + travel * 0.6, projectedOffset: base + travel, columns: columns,
+            geometry: NiriViewportGeometry(gap: gap, viewportSpan: viewport, orientation: .horizontal),
+            motion: .disabled, gestureStartOffset: intent ? base : nil
+        )
+        return state.activeColumnIndex
+    }
+
+    func testFullWidthColumnChangesWithTheGestureOfAHalfWidthOne() {
+        let full: [CGFloat] = [2058, 2058, 2058], half: [CGFloat] = [1025, 1025, 1025, 1025]
+        XCTAssertEqual(landing(widths: full, travel: 600, intent: false), 0, "before: 600 pt was not enough")
+        XCTAssertEqual(landing(widths: full, travel: 600), 1)
+        XCTAssertEqual(landing(widths: half, travel: 600), 1)
+    }
+
+    func testShortGestureStaysAndHalfWidthKeepsItsThreshold() {
+        XCTAssertEqual(landing(widths: [2058, 2058, 2058], travel: 400), 0)
+        XCTAssertEqual(landing(widths: [1025, 1025, 1025, 1025], travel: 400), 0)
+        XCTAssertEqual(landing(widths: [1025, 1025, 1025, 1025], travel: 600, intent: false), 1, "unchanged rule")
+    }
+
+    func testReversedGestureGoesBackOneColumn() {
+        XCTAssertEqual(landing(widths: [2058, 2058, 2058], from: 1, travel: -600), 0)
+        XCTAssertEqual(landing(widths: [2058, 2058, 2058], from: 1, travel: -300), 1)
+    }
+
+    func testLongFlickCanPassSeveralColumns() {
+        XCTAssertEqual(landing(widths: [2058, 2058, 2058], travel: 2500), 1)
+        XCTAssertEqual(landing(widths: [2058, 2058, 2058], travel: 4200), 2)
+    }
+}
