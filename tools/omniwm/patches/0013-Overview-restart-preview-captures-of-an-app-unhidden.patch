From b2ddfcda8e07728c6263c5fea04a5818872d9391 Mon Sep 17 00:00:00 2001
From: YamadaBlog <118530756+YamadaBlog@users.noreply.github.com>
Date: Fri, 9 Oct 2026 17:48:28 +0200
Subject: [PATCH 13/17] Overview: restart preview captures of an app unhidden
 while the Overview is open

(cherry picked from commit 6e122beb24d5b9303ac571d349446037464fc51d)
---
 .../OmniWM/Core/Overview/OverviewController.swift  | 14 ++++++++++++++
 .../Core/Overview/OverviewThumbnailCapture.swift   |  9 +++++++++
 2 files changed, 23 insertions(+)

diff --git a/Sources/OmniWM/Core/Overview/OverviewController.swift b/Sources/OmniWM/Core/Overview/OverviewController.swift
index 0e3d3264..0fb3685d 100644
--- a/Sources/OmniWM/Core/Overview/OverviewController.swift
+++ b/Sources/OmniWM/Core/Overview/OverviewController.swift
@@ -27,6 +27,7 @@ final class OverviewController {
     private var presentation: OverviewPresentation
 
     private let thumbnailCapture: OverviewThumbnailCapture
+    private var unhideObserver: NSObjectProtocol?
     let windowSession: OverviewWindowSession
     private(set) var animator: OverviewAnimator?
 
@@ -121,6 +122,19 @@ final class OverviewController {
         windowSession.onLayoutsUpdated = { [weak self] in
             self?.updatePreviewVisibility()
         }
+        unhideObserver = NSWorkspace.shared.notificationCenter.addObserver(
+            forName: NSWorkspace.didUnhideApplicationNotification,
+            object: nil,
+            queue: .main
+        ) { [weak self] notification in
+            let pid = (notification.userInfo?[NSWorkspace.applicationUserInfoKey] as? NSRunningApplication)?
+                .processIdentifier
+            MainActor.assumeIsolated {
+                guard let self, let pid, self.isOpen else { return }
+                self.thumbnailCapture.restartCaptures(forProcess: pid)
+                self.updatePreviewVisibility()
+            }
+        }
         windowSession.previewForHandle = { [weak thumbnailCapture] handle in
             thumbnailCapture?.preview(for: handle)
         }
diff --git a/Sources/OmniWM/Core/Overview/OverviewThumbnailCapture.swift b/Sources/OmniWM/Core/Overview/OverviewThumbnailCapture.swift
index 5820d6cf..382e60ea 100644
--- a/Sources/OmniWM/Core/Overview/OverviewThumbnailCapture.swift
+++ b/Sources/OmniWM/Core/Overview/OverviewThumbnailCapture.swift
@@ -153,6 +153,15 @@ final class OverviewThumbnailCapture {
         onReadinessChange()
     }
 
+    /// Drops the capture sources of a process so the next reconcile starts fresh streams, e.g. when
+    /// a hidden app is shown again while the Overview is open (its first frames were empty).
+    func restartCaptures(forProcess pid: pid_t) {
+        for (key, source) in sources where source.request.token.pid == pid {
+            retire(source)
+            sources.removeValue(forKey: key)
+        }
+    }
+
     func clear() {
         generation &+= 1
         isPresenting = false
