Subject: [PATCH 3/7] Overview: hidden search bar keeps a 44 pt top inset
 (notch band)

---
 Sources/OmniWM/Core/Overview/OverviewLayoutGeometry.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Sources/OmniWM/Core/Overview/OverviewLayoutGeometry.swift b/Sources/OmniWM/Core/Overview/OverviewLayoutGeometry.swift
index d4f2f330..0b1cf0d7 100644
--- a/Sources/OmniWM/Core/Overview/OverviewLayoutGeometry.swift
+++ b/Sources/OmniWM/Core/Overview/OverviewLayoutGeometry.swift
@@ -23,7 +23,7 @@ struct OverviewLayoutGeometry {
         let metricsScale = OverviewLayoutCalculator.clampedScale(scale)
         let hideSearchBar = UserDefaults.standard.bool(forKey: "OverviewHideSearchBar")
         let scaledSearchBarHeight = hideSearchBar ? 0 : OverviewLayoutMetrics.searchBarHeight * metricsScale
-        let scaledSearchBarPadding = hideSearchBar ? 0 : OverviewLayoutMetrics.searchBarPadding * metricsScale
+        let scaledSearchBarPadding = hideSearchBar ? 44 : OverviewLayoutMetrics.searchBarPadding * metricsScale  // clears the notch band
         let searchBarY = screenFrame.maxY - scaledSearchBarHeight - scaledSearchBarPadding
         let searchBarFrame = CGRect(
             x: screenFrame.minX + screenFrame.width * 0.25,
