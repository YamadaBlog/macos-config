From cd6bdfe48a2e681b16511f73dc237a7410d113ec Mon Sep 17 00:00:00 2001
From: YamadaBlog <118530756+YamadaBlog@users.noreply.github.com>
Date: Fri, 9 Oct 2026 15:43:56 +0200
Subject: [PATCH 12/15] Keep System Settings and auth dialogs in front: no
 hover focus while they own focus

(cherry picked from commit 22ee801b9ba25a62599ae9670ec8b4636f8d61d0)
---
 .../MouseEventHandler+FocusFollowsMouse.swift    | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift b/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift
index 440b06bf..64f1b7ee 100644
--- a/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift
+++ b/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift
@@ -16,12 +16,24 @@ extension MouseEventHandler {
             return true
         case .external:
             return workspaceManager.activeNativeFullscreenFocusOwnerToken == nil
-        case .managed,
-             .none:
+        case let .managed(token):
+            // System Settings and authorization dialogs keep focus until an explicit click:
+            // hovering a tiled window must not raise it above them.
+            guard let bundleId = NSRunningApplication(processIdentifier: token.pid)?.bundleIdentifier
+            else { return false }
+            return Self.hoverFocusExemptBundleIds.contains(bundleId)
+        case .none:
             return false
         }
     }
 
+    static let hoverFocusExemptBundleIds: Set<String> = [
+        "com.apple.systempreferences",
+        "com.apple.SecurityAgent",
+        "com.apple.LocalAuthentication.UIAgent",
+        "com.apple.coreservices.uiagent"
+    ]
+
     private enum FocusFollowsMouseTarget {
         case niri(workspaceId: WorkspaceDescriptor.ID, window: NiriWindow)
         case dwindle(workspaceId: WorkspaceDescriptor.ID, token: WindowToken)
