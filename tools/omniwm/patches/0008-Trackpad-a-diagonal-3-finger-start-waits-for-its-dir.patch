From 6de3059e064bfd0162727b2d3b24fd28ba89a207 Mon Sep 17 00:00:00 2001
From: YamadaBlog <118530756+YamadaBlog@users.noreply.github.com>
Date: Sun, 11 Oct 2026 11:50:18 +0200
Subject: [PATCH 08/17] Trackpad: a diagonal 3-finger start waits for its
 direction instead of killing the gesture

At the 16-unit recognition point the dominant axis alone decided; fingers that
drift down before moving sideways resolved to no mode and the gesture was
suppressed until all fingers lifted ("the swipe sometimes does nothing").
Diagonal starts (neither axis dominating by more than 2x) now stay armed up
to 4x the threshold. Clearly off-axis gestures are still rejected at once.

(cherry picked from commit dc980ac7a51792b005ba7d7bedbc2d9428007e71)
---
 .../MouseEventHandler+TrackpadLifecycle.swift | 13 ++++++++++++
 ...ouseEventHandler+TrackpadRecognition.swift |  2 +-
 .../Core/Input/TrackpadGestureIntent.swift    | 18 +++++++++++++++++
 .../TrackpadGestureIntentTests.swift          | 20 +++++++++++++++++++
 4 files changed, 52 insertions(+), 1 deletion(-)

diff --git a/Sources/OmniWM/Core/Controller/MouseEventHandler+TrackpadLifecycle.swift b/Sources/OmniWM/Core/Controller/MouseEventHandler+TrackpadLifecycle.swift
index e577268a..93c66810 100644
--- a/Sources/OmniWM/Core/Controller/MouseEventHandler+TrackpadLifecycle.swift
+++ b/Sources/OmniWM/Core/Controller/MouseEventHandler+TrackpadLifecycle.swift
@@ -26,6 +26,19 @@ extension MouseEventHandler {
             columnContextAvailable: lockedContext.columnScrollCandidate && controller.niriEngine != nil,
             windowContextAvailable: lockedContext.windowGestureTarget != nil
         ) else {
+            // Direction still ambiguous (e.g. fingers drift down before moving sideways): stay armed
+            // and decide on later frames instead of discarding the whole gesture.
+            if lockedContext.windowGestureTarget == nil,
+               TrackpadGestureIntent.mayResolveLater(
+                   config,
+                   fingerCount: lockedContext.fingerCount,
+                   translation: CGVector(dx: metrics.cumulativeX, dy: metrics.cumulativeY),
+                   recognitionThreshold: niriTouchpadGestureRecognitionThreshold
+               )
+            {
+                MouseTrace.record("gesture: direction ambiguous, waiting")
+                return false
+            }
             state.suppressGestureStartUntilAllTouchesLift = true
             resetGestureState()
             return false
diff --git a/Sources/OmniWM/Core/Controller/MouseEventHandler+TrackpadRecognition.swift b/Sources/OmniWM/Core/Controller/MouseEventHandler+TrackpadRecognition.swift
index d592cfd7..99ab4063 100644
--- a/Sources/OmniWM/Core/Controller/MouseEventHandler+TrackpadRecognition.swift
+++ b/Sources/OmniWM/Core/Controller/MouseEventHandler+TrackpadRecognition.swift
@@ -4,7 +4,7 @@
 import AppKit
 import Foundation
 
-private let niriTouchpadGestureRecognitionThreshold: CGFloat = 16.0
+let niriTouchpadGestureRecognitionThreshold: CGFloat = 16.0
 
 extension MouseEventHandler {
     struct GestureFrameMetrics {
diff --git a/Sources/OmniWM/Core/Input/TrackpadGestureIntent.swift b/Sources/OmniWM/Core/Input/TrackpadGestureIntent.swift
index c030a7c4..1a4d23bb 100644
--- a/Sources/OmniWM/Core/Input/TrackpadGestureIntent.swift
+++ b/Sources/OmniWM/Core/Input/TrackpadGestureIntent.swift
@@ -206,6 +206,24 @@ enum TrackpadGestureIntent {
         return .workspaceSwitch(axis: workspaceAxis)
     }
 
+    /// A workspace-swipe or Overview gesture whose direction is still ambiguous (diagonal: neither
+    /// axis dominates by more than 2x) keeps waiting until it has travelled `ambiguityWindow` times
+    /// the recognition threshold. A clearly off-axis gesture is still rejected at once.
+    static let ambiguityWindow: CGFloat = 4
+
+    static func mayResolveLater(
+        _ config: Config,
+        fingerCount: Int,
+        translation: CGVector,
+        recognitionThreshold: CGFloat
+    ) -> Bool {
+        let (ax, ay) = (abs(translation.dx), abs(translation.dy))
+        let distance = (ax * ax + ay * ay).squareRoot()
+        guard distance < recognitionThreshold * ambiguityWindow, min(ax, ay) * 2 >= max(ax, ay) else { return false }
+        return (config.workspaceSwipeEnabled && fingerCount == config.workspaceSwipeFingerCount)
+            || (config.overviewAction != nil && fingerCount == config.overviewFingerCount)
+    }
+
     static func windowGestureLocation(
         start: CGPoint,
         startTouch: CGPoint,
diff --git a/Tests/OmniWMTests/TrackpadGestureIntentTests.swift b/Tests/OmniWMTests/TrackpadGestureIntentTests.swift
index 9ae53b31..9b5c49d2 100644
--- a/Tests/OmniWMTests/TrackpadGestureIntentTests.swift
+++ b/Tests/OmniWMTests/TrackpadGestureIntentTests.swift
@@ -146,6 +146,26 @@ final class TrackpadGestureIntentTests: XCTestCase {
         )
     }
 
+    func testAmbiguousWorkspaceSwipeWaitsInsteadOfBeingDiscarded() {
+        let config = makeConfig(columnEnabled: false, workspaceFingers: 3, workspaceAxis: .horizontal)
+        // Fingers drifted down first: no mode yet, but the gesture may still become a swipe.
+        XCTAssertNil(TrackpadGestureIntent.resolveMode(
+            config, fingerCount: 3, cumulativeTranslation: CGVector(dx: 8, dy: -15),
+            columnScrollAxis: .horizontal, columnContextAvailable: false
+        ))
+        XCTAssertTrue(TrackpadGestureIntent.mayResolveLater(config, fingerCount: 3, translation: CGVector(dx: 8, dy: -15), recognitionThreshold: 16))
+        // Later frame, now sideways: resolves to the workspace swipe.
+        XCTAssertEqual(TrackpadGestureIntent.resolveMode(
+            config, fingerCount: 3, cumulativeTranslation: CGVector(dx: 40, dy: -18),
+            columnScrollAxis: .horizontal, columnContextAvailable: false
+        ), .workspaceSwitch(axis: .horizontal))
+        // Bounded: a long vertical gesture is eventually discarded; other finger counts never wait.
+        XCTAssertFalse(TrackpadGestureIntent.mayResolveLater(config, fingerCount: 3, translation: CGVector(dx: 40, dy: -50), recognitionThreshold: 16))
+        XCTAssertFalse(TrackpadGestureIntent.mayResolveLater(config, fingerCount: 2, translation: CGVector(dx: 8, dy: -15), recognitionThreshold: 16))
+        // Clearly vertical: rejected at once, as before.
+        XCTAssertFalse(TrackpadGestureIntent.mayResolveLater(config, fingerCount: 3, translation: CGVector(dx: 1, dy: -17), recognitionThreshold: 16))
+    }
+
     func testGestureStartAllowedForEitherEnabledFingerCount() {
         let config = makeConfig(columnFingers: 3, workspaceFingers: 4)
         XCTAssertTrue(TrackpadGestureIntent.allowsGestureStart(config, fingerCount: 3))
