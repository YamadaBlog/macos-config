From 73cfd913667e17b5cd74bbfd7ac84a8c44d83286 Mon Sep 17 00:00:00 2001
From: YamadaBlog <118530756+YamadaBlog@users.noreply.github.com>
Date: Sun, 18 Oct 2026 19:53:42 +0200
Subject: [PATCH 28/28] AX: a size write the app did not answer is no minimum
 size

Safari answers kAXErrorCannotComplete while it enters or leaves native fullscreen.
OmniWM learned the fullscreen size (2074x1300) as the window minimum, which pinned
the column at screen width: Option+F (toggleContainerFullPrimarySpan) then had no
visible effect until OmniWM restarted.
---
 .../WMController+ObservedSizing.swift         |  6 +++-
 .../WindowAdmissionFrameLifecycleTests.swift  | 28 +++++++++++++++++++
 2 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/Sources/OmniWM/Core/Controller/WMController+ObservedSizing.swift b/Sources/OmniWM/Core/Controller/WMController+ObservedSizing.swift
index 5633a2f2..ac541e99 100644
--- a/Sources/OmniWM/Core/Controller/WMController+ObservedSizing.swift
+++ b/Sources/OmniWM/Core/Controller/WMController+ObservedSizing.swift
@@ -35,7 +35,11 @@ extension WMController {
     }
 
     func adoptObservedMinimumAfterTerminalSizeWriteFailure(_ refusal: AXFrameTerminalRefusal) {
-        guard case .sizeWriteFailed = refusal.failureReason,
+        // cannotComplete: the app did not answer (Safari entering or leaving native fullscreen,
+        // 2026-10-18), so its fullscreen size is no minimum; learning it pinned the column at
+        // screen width and made toggleContainerFullPrimarySpan a no-op until OmniWM restarted.
+        guard case let .sizeWriteFailed(error) = refusal.failureReason,
+              error != .cannotComplete,
               let entry = workspaceManager.entry(forWindowId: refusal.windowId),
               entry.mode == .tiling,
               workspaceManager.hiddenState(for: entry.token) == nil
diff --git a/Tests/OmniWMTests/WindowAdmissionFrameLifecycleTests.swift b/Tests/OmniWMTests/WindowAdmissionFrameLifecycleTests.swift
index 7a8d584e..18a93f15 100644
--- a/Tests/OmniWMTests/WindowAdmissionFrameLifecycleTests.swift
+++ b/Tests/OmniWMTests/WindowAdmissionFrameLifecycleTests.swift
@@ -1158,6 +1158,34 @@ final class WindowAdmissionFrameLifecycleTests: XCTestCase {
         XCTAssertFalse(controller.axEventHandler.isAdmissionQuarantined(windowId: windowId, axRef: axRef))
     }
 
+    func testUnansweredSizeSetterDoesNotAdoptFullscreenFrameAsObservedMinimum() throws {
+        let controller = WindowAdmissionTestSupport.controller()
+        let workspaceId = try XCTUnwrap(
+            controller.workspaceManager.workspaceId(for: "1", createIfMissing: true)
+        )
+        let pid: pid_t = 467_316
+        let windowId = 467_419
+        let axRef = AXWindowRef(element: AXUIElementCreateApplication(pid), windowId: windowId)
+        let token = controller.workspaceManager.addWindow(
+            axRef,
+            pid: pid,
+            windowId: windowId,
+            to: workspaceId
+        )
+        let refusal = AXFrameTerminalRefusal(
+            pid: pid,
+            windowId: windowId,
+            targetFrame: CGRect(x: 16, y: 8, width: 1_025, height: 1_293),
+            observedFrame: CGRect(x: 0, y: 0, width: 2_074, height: 1_300),
+            failureReason: .sizeWriteFailed(.cannotComplete)
+        )
+
+        controller.axEventHandler.handleTerminalFrameRefusal(refusal)
+
+        XCTAssertNotNil(controller.workspaceManager.entry(for: token))
+        XCTAssertNil(controller.workspaceManager.observedSizeEvidence(for: token))
+    }
+
