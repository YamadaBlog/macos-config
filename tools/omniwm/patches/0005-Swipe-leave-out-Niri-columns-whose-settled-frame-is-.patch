+    /// A Niri column scrolled entirely past the content area keeps a "settled" frame that
+    /// `settledRenderedContainerRect` shifts to the screen edge and clamps on screen, so it lands
+    /// on top of the last visible column (Web, 2026-10-15: column 3 at x=1049 over column 2 at
+    /// x=1041) while the real window is parked off screen. Drawn in a swipe, the third window
+    /// covered the second. Tiled columns never overlap and never touch the screen edge (outer
+    /// gaps), so an item that does both is such a clamped off-screen column: leave it out.
+    static func droppingEdgeClampedNiriItems(
+        _ items: [WorkspaceSwipePreview.Item], monitorFrame: CGRect
+    ) -> [WorkspaceSwipePreview.Item] {
+        func touchesEdge(_ f: CGRect) -> Bool {
+            abs(f.maxX - monitorFrame.maxX) < 0.5 || abs(f.minX - monitorFrame.minX) < 0.5
+        }
+        func overlapsMostly(_ a: CGRect, _ b: CGRect) -> Bool {
+            let i = a.intersection(b)
+            guard !i.isNull else { return false }
+            return i.width * i.height > 0.5 * min(a.width * a.height, b.width * b.height)
+        }
+        return items.filter { item in
+            guard touchesEdge(item.frame) else { return true }
+            return !items.contains { other in
+                other.handle != item.handle && !touchesEdge(other.frame) && overlapsMostly(item.frame, other.frame)
+            }
+        }
+    }
+
