@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 BarutSRB — https://github.com/OmniNull/OmniWM
+
+import CoreGraphics
+@testable import OmniWM
+import XCTest
+
+/// Regression (2026-10-15): swiping away from a Niri workspace with an off-screen third column drew
+/// that column's edge-clamped settled frame on top of the second column.
+@MainActor
+final class WorkspaceSwipeNiriClampTests: XCTestCase {
+    private let screen = CGRect(x: 0, y: 0, width: 2074, height: 1301)
+    private func item(_ id: Int, _ frame: CGRect) -> WorkspaceSwipePreview.Item {
+        .init(handle: WindowHandle(id: WindowToken(pid: 610_000, windowId: id)), frame: frame)
+    }
+
+    func testDropsOffscreenColumnClampedOverTheLastVisibleOne() {
+        let col1 = item(1, CGRect(x: 8, y: 8, width: 1025, height: 1293))
+        let col2 = item(2, CGRect(x: 1041, y: 8, width: 1025, height: 1293))
+        let clamped = item(3, CGRect(x: 1049, y: 8, width: 1025, height: 1293))
+        let kept = WorkspaceSwipePresentation.droppingEdgeClampedNiriItems([col1, col2, clamped], monitorFrame: screen)
+        XCTAssertEqual(kept.map(\.handle.windowId), [1, 2])
+    }
+
+    func testKeepsColumnsThatOnlyTouchTheEdge() {
+        let full = item(1, CGRect(x: 0, y: 0, width: 2074, height: 1301))
+        let other = item(2, CGRect(x: 2074, y: 0, width: 1000, height: 1301))
+        let kept = WorkspaceSwipePresentation.droppingEdgeClampedNiriItems([full, other], monitorFrame: screen)
+        XCTAssertEqual(kept.count, 2)
+    }
+
+    func testKeepsOrdinaryTiling() {
+        let a = item(1, CGRect(x: 8, y: 8, width: 1025, height: 1293))
+        let b = item(2, CGRect(x: 1041, y: 8, width: 1025, height: 1293))
+        XCTAssertEqual(WorkspaceSwipePresentation.droppingEdgeClampedNiriItems([a, b], monitorFrame: screen).count, 2)
+    }
+}
